@startuml
left to right direction
actor "Пользователь" as User
actor "Администратор" as Admin

rectangle "Музыкальная библиотека" {
  User -- (Просмотр профиля)
  User -- (Редактирование профиля)
  User -- (Просмотр своих треков)
  User -- (Добавление трека)
  User -- (Редактирование своего трека)
  User -- (Удаление своего трека)
  User -- (Поиск и фильтрация треков)
  User -- (Создание коллекции)
  User -- (Добавление трека в коллекцию)
  User -- (Просмотр коллекции)
  User -- (Удаление трека из коллекции)
  User -- (Отметка трека как «Любимый»)
  User -- (Выбор любимых жанров)
  User -- (Выбор любимых исполнителей)

  Admin -- (Просмотр всех треков)
  Admin -- (Просмотр всех коллекций)
  Admin -- (Управление жанрами)
  Admin -- (Управление пользователями)
  Admin -- (Просмотр журнала операций)
  Admin -- (Удаление/редактирование любых записей)
}

User .> Admin : (наследует права админа\nв некоторых реализациях – нет,\nно для диаграммы можно показать\nили оставить отдельно)

note right of Admin
  Администратор имеет\n
  полный доступ ко всей БД.
end note

note right of User
  Обычный пользователь\n
  работает только\n
  со своими данными.
end note

@enduml